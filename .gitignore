# Sensitive files
*.env
*.env.*
.env.local
.env.production

# Allow env example template to be committed
!.env.example
*.key
*.pem
*.crt

# Database files (contains sensitive data)
*.db
*.sqlite
*.sqlite3
/database/*.json

# Logs and runtime
.lan-logs/
*.log
*.pid

# IDE and local configs
.claude/
.continue/
.mcp.json
.DS_Store

# All database and memory (contains sensitive data)
**/database/
**/memory/
**/backup/
**/backups/
**/storage/
**/attachments/
**/payslips/
**/outputs/

# Backup folders
backup/
database_backup_*/

# Sample files (if they contain real data)
newproject/sample-files/

# Personal documents
*.docx
*.xlsx
*.pptx
!**/docs/*.md
!**/README.md

# CSV with employee data
*.csv
!**/requirements*.csv
